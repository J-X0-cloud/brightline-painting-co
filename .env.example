# Canonical origin used for metadata, sitemap.xml and JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.brightlinepainting.com

# CRM / lead inbox that receives quote requests (JSON POST).
# When unset, leads are logged to the server console.
LEADS_WEBHOOK_URL=
# Optional shared secret sent as the X-Brightline-Signature header
LEADS_WEBHOOK_SECRET=
